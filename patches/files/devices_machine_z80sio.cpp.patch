+//-------------------------------------------------
+//  read_vector - the MK68564 modifies V2-V0 when
+//  either channel's INTCTL has status affects
+//  vector: B transmit, external, receive, special,
+//  then the same four for A
+//-------------------------------------------------
+uint8_t mk68564_device::read_vector()
+{
+	uint8_t vec = m_chanB->m_wr2;
+	if (!((m_chanA->m_wr1 | m_chanB->m_wr1) & WR1_STATUS_VECTOR))
+		return vec;
+	vec &= 0xf8U;
+
+	int const *const prio = interrupt_priorities();
+	for (int i = 0; std::size(m_int_state) > i; ++i)
+	{
+		if (m_int_state[prio[i]] & Z80_DAISY_INT)
+		{
+			int const ch = prio[i] / 3;
+			z80sio_channel const &chan = ch ? *m_chanB : *m_chanA;
+			uint8_t const base = ch ? 0x00U : 0x04U;
+			switch (prio[i] % 3)
+			{
+			case z80sio_channel::INT_TRANSMIT:
+				return vec | base;
+			case z80sio_channel::INT_EXTERNAL:
+				return vec | base | 0x01U;
+			default:
+				return vec | base | ((chan.m_rr1 & chan.get_special_rx_mask()) ? 0x03U : 0x02U);
+			}
+		}
+	}
+	return vec | 0x06U;
+}
