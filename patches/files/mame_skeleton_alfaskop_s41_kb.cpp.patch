+//-------------------------------------------------
+//  read_rows - row byte for the column currently
+//  selected by the walking zero
+//
+//  Key numbers are the firmware's own coordinates: its scan loop stores one
+//  row byte per column at $70-$7F and tests bit (keynum & 7) of byte
+//  (keynum >> 3), so keynum = column * 8 + row.  Port P1n bit b is key
+//  number n * 16 + b.  The LS240 read gates invert, so a depressed key
+//  reads as a one.
+//-------------------------------------------------
+
+uint8_t alfaskop_s41_keyboard_device::read_rows()
+{
+	uint16_t const pressed = ~m_rows[m_col_select >> 1]->read(); // ports are active low
+	uint8_t rows = pressed >> ((m_col_select & 1) * 8);
+	if (m_shift_pf13)
+	{
+		static constexpr uint8_t pf_low[12] = { 30, 46, 62, 78, 94, 110, 126, 15, 31, 47, 63, 79 };
+		static constexpr uint8_t pf_high[12] = { 2, 3, 4, 5, 40, 41, 42, 43, 44, 45, 80, 81 };
+		auto down = [this] (int key) { return !BIT(m_rows[key >> 4]->read(), key & 15); };
+		if (down(32))
+		{
+			bool any = false;
+			for (int i = 0; i < 12; i++)
+			{
+				any = any || down(pf_low[i]);
+				if ((pf_low[i] >> 3) == m_col_select)
+					rows &= ~(1 << (pf_low[i] & 7));
+				if ((pf_high[i] >> 3) == m_col_select && down(pf_low[i]))
+					rows |= 1 << (pf_high[i] & 7);
+			}
+			// the Ericsson shift plane turns PF13-PF20 into local functions, so the KBC must not see Shift
+			if (any && (32 >> 3) == m_col_select)
+				rows &= ~(1 << (32 & 7));
+		}
+	}
+	return rows;
+}
